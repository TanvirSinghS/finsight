# ---------------------------------------------------------------------------
# FinSight environment variables (copy to .env for docker-compose or set in
# Render / Vercel dashboards). Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon connection string uses ?sslmode=require)
DB_URL=jdbc:postgresql://localhost:5432/finsight
DB_USERNAME=finsight
DB_PASSWORD=finsight

# Alternative single-URL form handed out by Neon/Render. Used only when DB_URL is
# unset; the app splits it into the JDBC url, username and password automatically.
# Prefer the direct (unpooled) endpoint when the app pools connections itself.
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_EXPIRATION_MINUTES=10080

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Python analytics service
INSIGHTS_SERVICE_URL=http://localhost:8000
INSIGHTS_TIMEOUT_SECONDS=20

# Frankfurter FX API (no key required)
FRANKFURTER_URL=https://api.frankfurter.app
CURRENCY_CACHE_MINUTES=360

# Frontend build-time API base URL (empty = same origin / Vite proxy)
VITE_API_BASE_URL=
